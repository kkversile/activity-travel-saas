model Tenant {
  id                       String                                   @id @default(uuid())
  name                     String
  slug                     String                                   @unique
  kind                     TenantKind                               @default(VENDOR)
  users                    User[]
  vendorProfile            VendorProfile?
  agentProfile             AgentProfile?
  vendorBookings           Booking[]                                @relation("BookingVendor")
  agentBookings            Booking[]                                @relation("BookingAgent")
  payouts                  Payout[]
  financialEvents          FinancialEvent[]
  settlementPolicies       VendorSettlementPolicy[]                 @relation("SettlementPolicyVendor")
  settlementHolds          SettlementHold[]
  settlementBatches        SettlementBatch[]
  cancellationResolutions  CancellationVendorSettlementResolution[]
  auditLogs                AuditLog[]
  fileAssets               FileAsset[]
  vendorDocuments          VendorDocument[]
  outboxEvents             OutboxEvent[]
  products                 Product[]
  resources                Resource[]
  agentGroupMembers        AgentGroupMember[]
  commercialRulesAsVendor  CommercialRule[]                         @relation("CommercialRuleVendor")
  commercialRulesAsAgent   CommercialRule[]                         @relation("CommercialRuleAgent")
  qualitySnapshots         SupplierQualitySnapshot[]                @relation("SupplierQualitySnapshotVendor")
  tierAssignments          SupplierTierAssignment[]                 @relation("SupplierTierAssignmentVendor")
  qualityIssues            SupplierQualityIssue[]                   @relation("SupplierQualityIssueVendor")
  demandSearchObservations MarketplaceSearchObservation[]           @relation("DemandSearchObservationAgent")
  demandVendorTargets      DemandOpportunityVendorTarget[]          @relation("DemandTargetVendor")
  createdAt                DateTime                                 @default(now())
  updatedAt                DateTime                                 @updatedAt
}

model User {
  id                              String                          @id @default(uuid())
  tenantId                        String?
  tenant                          Tenant?                         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email                           String                          @unique
  passwordHash                    String
  fullName                        String
  role                            UserRole
  organizationRole                OrganizationRole?
  active                          Boolean                         @default(true)
  createdFileAssets               FileAsset[]
  createdDocumentVersions         VendorDocumentVersion[]         @relation("DocumentVersionCreatedBy")
  reviewedDocumentVersions        VendorDocumentVersion[]         @relation("DocumentVersionReviewedBy")
  createdProductRevisions         ProductRevision[]               @relation("ProductRevisionCreatedBy")
  reviewedProductRevisions        ProductRevision[]               @relation("ProductRevisionReviewedBy")
  createdCommercialVersions       RatePlanCommercialVersion[]     @relation("CommercialVersionCreatedBy")
  activatedCommercialVersions     RatePlanCommercialVersion[]     @relation("CommercialVersionActivatedBy")
  agentBookings                   Booking[]                       @relation("BookingAgentUser")
  createdCommercialRules          CommercialRule[]                @relation("CommercialRuleCreatedBy")
  createdCommercialRuleVersions   CommercialRuleVersion[]         @relation("CommercialRuleVersionCreatedBy")
  activatedCommercialRuleVersions CommercialRuleVersion[]         @relation("CommercialRuleVersionActivatedBy")
  reviewedAgentProfiles           AgentProfile[]                  @relation("AgentProfileReviewedBy")
  createdQualityPolicies          SupplierQualityPolicy[]         @relation("SupplierQualityPolicyCreatedBy")
  activatedQualityPolicies        SupplierQualityPolicy[]         @relation("SupplierQualityPolicyActivatedBy")
  assignedSupplierTiers           SupplierTierAssignment[]        @relation("SupplierTierAssignmentAssignedBy")
  acknowledgedQualityIssues       SupplierQualityIssue[]          @relation("SupplierQualityIssueAcknowledgedBy")
  resolvedQualityIssues           SupplierQualityIssue[]          @relation("SupplierQualityIssueResolvedBy")
  createdDemandPolicies           DemandIntelligencePolicy[]      @relation("DemandPolicyCreatedBy")
  activatedDemandPolicies         DemandIntelligencePolicy[]      @relation("DemandPolicyActivatedBy")
  generatedDemandRuns             DemandAnalysisRun[]             @relation("DemandRunGeneratedBy")
  ownedDemandOpportunities        DemandOpportunity[]             @relation("DemandOpportunityOwner")
  targetedDemandVendors           DemandOpportunityVendorTarget[] @relation("DemandTargetedBy")
  respondedDemandVendors          DemandOpportunityVendorTarget[] @relation("DemandRespondedBy")
  removedDemandVendorTargets      DemandOpportunityVendorTarget[] @relation("DemandRemovedBy")
  demandOpportunityEvents         DemandOpportunityEvent[]        @relation("DemandEventActor")
  createdAt                       DateTime                        @default(now())
  updatedAt                       DateTime                        @updatedAt

  @@index([tenantId, role])
}

model VendorProfile {
  id                  String                   @id @default(uuid())
  tenantId            String                   @unique
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalBusinessName   String
  operatingCity       String
  operatingRegion     String
  gstin               String?
  category            String?
  verificationStatus  VendorVerificationStatus @default(PENDING)
  readinessScore      Int                      @default(0)
  payoutAccountMasked String?
  payoutAccountHolder String?
  payoutBankName      String?
  payoutBranch        String?
  payoutIfsc          String?
  payoutSwift         String?
  payoutAccountType   String?
  payoutCurrency      String?
  documentStatus      Json                     @default("{}")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model AgentProfile {
  id                 String                  @id @default(uuid())
  tenantId           String                  @unique
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalBusinessName  String
  verificationStatus AgentVerificationStatus @default(PENDING)
  reviewReason       String?
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?                   @relation("AgentProfileReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([verificationStatus])
}

model FileAsset {
  id                 String                  @id @default(uuid())
  tenantId           String?
  tenant             Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  storageKey         String                  @unique
  originalName       String
  mimeType           String
  sizeBytes          Int
  visibility         FileVisibility
  purpose            FilePurpose
  entityType         String?
  entityId           String?
  createdById        String?
  createdBy          User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt         DateTime?
  createdAt          DateTime                @default(now())
  documentVersions   VendorDocumentVersion[]
  productMedia       ProductMedia[]
  fulfilmentEvidence FulfilmentEvidence[]
  voucherVersions    VoucherVersion[]

  @@index([tenantId, visibility])
  @@index([purpose, entityId])
  @@index([createdAt])
}

model VendorDocument {
  id            String                  @id @default(uuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          VendorDocumentType
  currentStatus DocumentReviewStatus    @default(PENDING)
  versions      VendorDocumentVersion[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([tenantId, type])
  @@index([tenantId, currentStatus])
}

model VendorDocumentVersion {
  id               String               @id @default(uuid())
  vendorDocumentId String
  vendorDocument   VendorDocument       @relation(fields: [vendorDocumentId], references: [id], onDelete: Cascade)
  versionNumber    Int
  fileAssetId      String
  fileAsset        FileAsset            @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  status           DocumentReviewStatus @default(PENDING)
  expiresAt        DateTime?
  rejectionReason  String?
  submittedAt      DateTime             @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?                @relation("DocumentVersionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User                 @relation("DocumentVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())

  @@unique([vendorDocumentId, versionNumber])
  @@index([vendorDocumentId, status])
}

model Product {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productCode       String
  status            ProductStatus     @default(DRAFT)
  currentRevisionId String?
  currentRevision   ProductRevision?  @relation("CurrentProductRevision", fields: [currentRevisionId, id], references: [id, productId], onDelete: NoAction)
  revisions         ProductRevision[] @relation("ProductRevisions")
  variants          ProductVariant[]
  promotions        Promotion[]
  pricingRules      PricingRule[]
  bookings          Booking[]
  commercialRules   CommercialRule[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([tenantId, productCode])
  @@index([tenantId, status])
}

model ProductRevision {
  id                  String                   @id @default(uuid())
  productId           String
  product             Product                  @relation("ProductRevisions", fields: [productId], references: [id], onDelete: Cascade)
  versionNumber       Int
  status              ProductRevisionStatus    @default(DRAFT)
  productName         String
  type                ProductType
  subType             String
  description         String
  shortDescription    String?
  terms               String[]                 @default([])
  faqs                Json                     @default("[]")
  highlights          String[]                 @default([])
  channels            String[]                 @default([])
  highlightedPriority Int?
  isHotelLinked       Boolean                  @default(false)
  attachedHotelIds    String[]                 @default([])
  howToRedeem         String[]                 @default([])
  subCategory         String?
  persuasions         String[]                 @default([])
  labels              String[]                 @default([])
  rank                Int?
  starRating          Decimal?                 @db.Decimal(3, 2)
  safetyMeasures      String[]                 @default([])
  importantInfo       String[]                 @default([])
  thingsToCarry       String[]                 @default([])
  additionalInfo      String[]                 @default([])
  metaname            String?
  cityCode            String?
  lat                 Decimal?                 @db.Decimal(10, 7)
  lon                 Decimal?                 @db.Decimal(10, 7)
  address             String?
  cityName            String
  countryName         String
  stateName           String
  sourcePayload       Json?
  rejectionReason     String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedById        String?
  reviewedBy          User?                    @relation("ProductRevisionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User                     @relation("ProductRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  media               ProductMedia[]
  currentForProducts  Product[]                @relation("CurrentProductRevision")
  bookingQuestions    ProductBookingQuestion[]
  fulfilmentPolicy    ProductFulfilmentPolicy?
  bookings            Booking[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([productId, versionNumber])
  @@unique([id, productId])
  @@index([productId, status])
}

model ProductFulfilmentPolicy {
  id                     String                   @id @default(uuid())
  productRevisionId      String                   @unique
  productRevision        ProductRevision          @relation(fields: [productRevisionId], references: [id], onDelete: Cascade)
  mode                   FulfilmentMode?
  requiredEvidenceKinds  FulfilmentEvidenceKind[] @default([])
  evidenceMatchMode      EvidenceMatchMode        @default(ALL)
  reviewRequired         Boolean                  @default(false)
  emergencyContactName   String?
  emergencyContactPhone  String?
  emergencyContactEmail  String?
  operationsContactName  String?
  operationsContactPhone String?
  operationsContactEmail String?
  voucherNotes           String[]                 @default([])
  migrationMetadata      Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}

model ProductMedia {
  id             String          @id @default(uuid())
  revisionId     String
  revision       ProductRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  kind           MediaKind
  fileAssetId    String?
  fileAsset      FileAsset?      @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  externalUrl    String?
  description    String?
  seoTitle       String?
  seoDescription String?
  rank           Int             @default(1)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([revisionId, kind])
}

model ProductBookingQuestion {
  id                  String              @id @default(uuid())
  productRevisionId   String
  productRevision     ProductRevision     @relation(fields: [productRevisionId], references: [id], onDelete: Cascade)
  code                String
  label               String
  helpText            String?
  type                BookingQuestionType
  required            Boolean             @default(false)
  options             Json?
  appliesPerTraveller Boolean             @default(false)
  rank                Int                 @default(0)
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([productRevisionId, code])
  @@index([productRevisionId, archivedAt, rank])
}

model ProductVariant {
  id               String             @id @default(uuid())
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantCode      String
  name             String
  description      String?
  status           VariantStatus      @default(ACTIVE)
  durationMinutes  Int?
  privateShared    String?
  vehicleType      String?
  pickupIncluded   Boolean            @default(false)
  pickupType       String?
  pickupInput      String?
  pickupTimings    String?
  dropoffIncluded  Boolean            @default(false)
  dropoffTimings   String?
  mealIncluded     Boolean            @default(false)
  mealType         String?
  menu             String[]           @default([])
  mealVariety      String?
  pointsOfInterest String[]           @default([])
  inclusions       String[]           @default([])
  exclusions       String[]           @default([])
  suitableFor      String[]           @default([])
  sourcePayload    Json?
  version          Int                @default(1)
  archivedAt       DateTime?
  ratePlans        RatePlan[]
  schedules        ScheduleTemplate[]
  commercialRules  CommercialRule[]
  bookings         Booking[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([productId, variantCode])
  @@index([productId, status])
}

model RatePlan {
  id                  String                      @id @default(uuid())
  variantId           String
  variant             ProductVariant              @relation(fields: [variantId], references: [id], onDelete: Restrict)
  ratePlanCode        String
  name                String
  status              RatePlanStatus              @default(ACTIVE)
  description         String?
  validFrom           DateTime
  validTo             DateTime
  currency            String                      @default("INR")
  unitType            String                      @default("per_person")
  basePrice           Decimal                     @default(0) @db.Decimal(12, 2)
  freehold            Boolean                     @default(false)
  minPax              Int                         @default(1)
  maxPax              Int                         @default(99)
  affiliates          String[]                    @default([])
  instantConfirmation Boolean                     @default(false)
  cutOffMinutes       Int                         @default(0)
  dateLevelCutoffTime String?
  adultRequired       Boolean                     @default(false)
  minAdultRequired    Int                         @default(0)
  sourcePayload       Json?
  travellerRules      TravellerRule[]
  cancellationRules   CancellationRule[]
  scheduleMappings    RatePlanSchedule[]
  channelMappings     RatePlanChannelMapping[]
  bookings            Booking[]
  commercialVersions  RatePlanCommercialVersion[]
  commercialRules     CommercialRule[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([variantId, ratePlanCode])
