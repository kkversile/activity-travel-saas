}

model BookingCancellation {
  id                         String                                  @id @default(uuid())
  bookingId                  String                                  @unique
  booking                    Booking                                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  initiator                  CancellationInitiator
  initiatedByUserId          String?
  initiatedByTenantId        String?
  reasonCategory             CancellationReasonCategory
  reason                     String
  cancelledAt                DateTime
  serviceTimezone            String
  serviceDateLocal           String
  cancellationDateLocal      String
  daysBeforeService          Int
  policyFingerprint          String?
  matchedPolicyRule          Json?
  bookingAmount              Decimal                                 @db.Decimal(18, 4)
  currency                   String
  cancellationCharge         Decimal                                 @db.Decimal(18, 4)
  refundEntitlement          Decimal                                 @db.Decimal(18, 4)
  financialState             CancellationFinancialState
  idempotencyKey             String?
  requestFingerprint         String?
  calculationSnapshot        Json
  refund                     Refund?
  financialEvents            FinancialEvent[]
  vendorSettlementResolution CancellationVendorSettlementResolution?
  createdAt                  DateTime                                @default(now())
  updatedAt                  DateTime                                @updatedAt

  @@unique([bookingId, idempotencyKey])
  @@index([initiator, financialState])
  @@index([financialState, createdAt])
}

model Refund {
  id                String              @id @default(uuid())
  bookingId         String
  booking           Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  cancellationId    String              @unique
  cancellation      BookingCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  amount            Decimal             @db.Decimal(18, 4)
  currency          String
  status            RefundStatus        @default(PENDING)
  externalReference String?
  failureReason     String?
  requestedAt       DateTime            @default(now())
  confirmedAt       DateTime?
  failedAt          DateTime?
  version           Int                 @default(1)
  createdById       String?
  confirmedById     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  financialEvents   FinancialEvent[]

  @@index([bookingId, status])
  @@index([status, createdAt])
}

model FinancialEvent {
  id                               String                                  @id @default(uuid())
  eventKey                         String                                  @unique
  bookingId                        String?
  booking                          Booking?                                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  vendorTenantId                   String
  vendorTenant                     Tenant                                  @relation(fields: [vendorTenantId], references: [id], onDelete: Restrict)
  agentTenantId                    String?
  settlementBatchId                String?
  settlementBatch                  SettlementBatch?                        @relation(fields: [settlementBatchId], references: [id], onDelete: Restrict)
  payoutId                         String?
  payout                           Payout?                                 @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  cancellationId                   String?
  cancellation                     BookingCancellation?                    @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  refundId                         String?
  refund                           Refund?                                 @relation(fields: [refundId], references: [id], onDelete: Restrict)
  cancellationSettlementResolution CancellationVendorSettlementResolution?
  settlementHolds                  SettlementHold[]
  settlementAllocations            SettlementEventAllocation[]
  type                             FinancialEventType
  status                           FinancialEventStatus
  currency                         String
  amount                           Decimal?                                @db.Decimal(18, 4)
  vendorAmount                     Decimal?                                @db.Decimal(18, 4)
  components                       Json
  reason                           String?
  reference                        String?
  actorUserId                      String?
  occurredAt                       DateTime
  createdAt                        DateTime                                @default(now())

  @@index([bookingId, occurredAt])
  @@index([vendorTenantId, occurredAt])
  @@index([type, status, occurredAt])
}

model Payout {
  id                      String           @id @default(uuid())
  tenantId                String
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recordType              PayoutRecordType @default(LEGACY)
  settlementBatchId       String?          @unique
  settlementBatch         SettlementBatch? @relation(fields: [settlementBatchId], references: [id], onDelete: Restrict)
  amount                  Decimal          @db.Decimal(18, 4)
  status                  PayoutStatus
  dueDate                 DateTime         @db.Date
  reference               String?
  currency                String           @default("INR")
  version                 Int              @default(1)
  releasedAt              DateTime?
  releasedById            String?
  failureReason           String?
  reconciledAt            DateTime?
  reconciledById          String?
  reconciledAmount        Decimal?         @db.Decimal(18, 4)
  reconciliationReference String?
  reconciliationNote      String?
  attempts                PayoutAttempt[]
  financialEvents         FinancialEvent[]
  createdAt               DateTime         @default(now())

  @@index([tenantId, status])
}

model FinanceConfiguration {
  id                    String                @id @default("default")
  paymentCollectionMode PaymentCollectionMode @default(UNCONFIGURED)
  baseCurrency          String                @default("INR")
  version               Int                   @default(1)
  updatedById           String?
  updatedAt             DateTime              @updatedAt
}

model VendorSettlementPolicy {
  id                  String                       @id @default(uuid())
  vendorTenantId      String                       @unique
  vendorTenant        Tenant                       @relation("SettlementPolicyVendor", fields: [vendorTenantId], references: [id], onDelete: Restrict)
  cycleMode           SettlementCycleMode          @default(MANUAL)
  eligibilityTrigger  SettlementEligibilityTrigger @default(SERVICE_COMPLETED)
  settlementDelayDays Int                          @default(0)
  weeklyDay           Int?
  active              Boolean                      @default(false)
  reviewRequired      Boolean                      @default(true)
  version             Int                          @default(1)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
}

model CancellationVendorSettlementResolution {
  id                     String              @id @default(uuid())
  cancellationId         String              @unique
  cancellation           BookingCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  bookingId              String
  booking                Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  vendorTenantId         String
  vendorTenant           Tenant              @relation(fields: [vendorTenantId], references: [id], onDelete: Restrict)
  originalVendorPayable  Decimal             @db.Decimal(18, 4)
  finalVendorPayable     Decimal             @db.Decimal(18, 4)
  vendorAdjustmentAmount Decimal             @db.Decimal(18, 4)
  financialEventId       String              @unique
  financialEvent         FinancialEvent      @relation(fields: [financialEventId], references: [id], onDelete: Restrict)
  reason                 String
  reference              String
  resolvedById           String
  resolvedAt             DateTime            @default(now())
  createdAt              DateTime            @default(now())
}

model SettlementHold {
  id               String               @id @default(uuid())
  vendorTenantId   String
  vendorTenant     Tenant               @relation(fields: [vendorTenantId], references: [id], onDelete: Restrict)
  scope            SettlementHoldScope
  bookingId        String?
  booking          Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  financialEventId String?
  financialEvent   FinancialEvent?      @relation(fields: [financialEventId], references: [id], onDelete: Restrict)
  status           SettlementHoldStatus @default(ACTIVE)
  reason           String
  reference        String?
  createdById      String
  createdAt        DateTime             @default(now())
  releasedById     String?
  releasedAt       DateTime?
  releaseReason    String?

  @@index([vendorTenantId, status])
  @@index([bookingId, status])
  @@index([financialEventId, status])
}

model SettlementBatch {
  id                 String                      @id @default(uuid())
  batchCode          String                      @unique
  vendorTenantId     String
  vendorTenant       Tenant                      @relation(fields: [vendorTenantId], references: [id], onDelete: Restrict)
  currency           String
  policySnapshot     Json
  periodFrom         DateTime?
  periodTo           DateTime?
  status             SettlementBatchStatus
  grossBookingValue  Decimal                     @db.Decimal(18, 4)
  vendorBasePayable  Decimal                     @db.Decimal(18, 4)
  adjustmentTotal    Decimal                     @db.Decimal(18, 4)
  netPayable         Decimal                     @db.Decimal(18, 4)
  eventCount         Int
  lineCount          Int
  previewFingerprint String
  createdById        String
  createdAt          DateTime                    @default(now())
  releasedAt         DateTime?
  reconciledAt       DateTime?
  version            Int                         @default(1)
  lines              SettlementLine[]
  allocations        SettlementEventAllocation[]
  financialEvents    FinancialEvent[]
  payout             Payout?

  @@index([vendorTenantId, status, createdAt])
}

model SettlementLine {
  id                String                      @id @default(uuid())
  batchId           String
  batch             SettlementBatch             @relation(fields: [batchId], references: [id], onDelete: Restrict)
  bookingId         String?
  booking           Booking?                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  lineType          String
  currency          String
  grossBookingValue Decimal                     @db.Decimal(18, 4)
  vendorPayableBase Decimal                     @db.Decimal(18, 4)
  adjustmentAmount  Decimal                     @db.Decimal(18, 4)
  netVendorPayable  Decimal                     @db.Decimal(18, 4)
  taxInformational  Decimal                     @db.Decimal(18, 4)
  components        Json
  createdAt         DateTime                    @default(now())
  allocations       SettlementEventAllocation[]

  @@index([batchId])
  @@index([bookingId])
}

model SettlementEventAllocation {
  id               String                     @id @default(uuid())
  batchId          String
  batch            SettlementBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  lineId           String
  line             SettlementLine             @relation(fields: [lineId], references: [id], onDelete: Restrict)
  financialEventId String
  financialEvent   FinancialEvent             @relation(fields: [financialEventId], references: [id], onDelete: Restrict)
  status           SettlementAllocationStatus @default(ALLOCATED)
  createdAt        DateTime                   @default(now())
  releasedAt       DateTime?

  @@index([financialEventId, status])
}

model PayoutAttempt {
  id                String              @id @default(uuid())
  payoutId          String
  payout            Payout              @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  attemptNumber     Int
  status            PayoutAttemptStatus
  amount            Decimal             @db.Decimal(18, 4)
  currency          String
  externalReference String?
  failureReason     String?
  actorUserId       String
  occurredAt        DateTime
  createdAt         DateTime            @default(now())

  @@unique([payoutId, attemptNumber])
}

model AuditLog {
  id            String    @id @default(uuid())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorId       String?
  actorRole     UserRole?
  action        String
  entityType    String
  entityId      String?
  reason        String?
  beforeState   Json?
  afterState    Json?
  correlationId String?
  metadata      Json?
  payload       Json?
  createdAt     DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([correlationId])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  tenantId      String?
  tenant        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  eventType     String
  aggregateType String
  aggregateId   String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
  @@index([tenantId, createdAt])
  @@index([aggregateType, aggregateId])
}

model SupplierQualityPolicy {
  id                     String                      @id @default(uuid())
  versionNumber          Int                         @unique
  status                 SupplierQualityPolicyStatus @default(DRAFT)
  name                   String
  measurementWindowDays  Int
  shortNoticeDays        Int
  lastMinuteStopSellDays Int
  createdById            String
  createdBy              User                        @relation("SupplierQualityPolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime                    @default(now())
  activatedById          String?
  activatedBy            User?                       @relation("SupplierQualityPolicyActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  activatedAt            DateTime?
  retiredAt              DateTime?
  lockVersion            Int                         @default(1)
  metricRules            SupplierQualityMetricRule[]
  tierRules              SupplierTierRule[]
  snapshots              SupplierQualitySnapshot[]

  @@index([status])
  @@index([activatedAt])
}

model SupplierQualityMetricRule {
  id                   String                             @id @default(uuid())
  policyId             String
  policy               SupplierQualityPolicy              @relation(fields: [policyId], references: [id], onDelete: Cascade)
  metricCode           SupplierQualityMetricCode
  dimension            SupplierQualityDimension
  enabled              Boolean                            @default(true)
  direction            SupplierMetricDirection
  weight               Float
  targetValue          Float
  warningValue         Float
  minimumSampleSize    Int                                @default(1)
  missingDataTreatment SupplierMetricMissingDataTreatment @default(EXCLUDE)
  passScore            Float                              @default(100)
  warnScore            Float                              @default(50)
  failScore            Float                              @default(0)
  rank                 Int                                @default(0)
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  @@unique([policyId, metricCode])
  @@index([policyId, enabled, rank])
}

model SupplierTierRule {
  id           String                @id @default(uuid())
  policyId     String
  policy       SupplierQualityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  tier         SupplierTier
  minimumScore Float
  createdAt    DateTime              @default(now())

  @@unique([policyId, tier])
  @@index([policyId, minimumScore])
}

model SupplierQualitySnapshot {
  id                       String                          @id @default(uuid())
  vendorTenantId           String
  vendorTenant             Tenant                          @relation("SupplierQualitySnapshotVendor", fields: [vendorTenantId], references: [id], onDelete: Restrict)
  policyId                 String?
  policy                   SupplierQualityPolicy?          @relation(fields: [policyId], references: [id], onDelete: SetNull)
  windowStart              DateTime
  windowEnd                DateTime
  overallScore             Float?
  recommendedTier          SupplierTier?
  currentTierAtCalculation SupplierTier?
  generatedAt              DateTime                        @default(now())
  metrics                  Json
  snapshotKey              String                          @unique
  metricSnapshots          SupplierQualityMetricSnapshot[]
  issues                   SupplierQualityIssue[]
  tierAssignments          SupplierTierAssignment[]        @relation("SupplierTierAssignmentSourceSnapshot")

  @@index([vendorTenantId, generatedAt])
  @@index([vendorTenantId, windowStart, windowEnd])
}

model SupplierQualityMetricSnapshot {
  id          String                    @id @default(uuid())
  snapshotId  String
  snapshot    SupplierQualitySnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  metricCode  SupplierQualityMetricCode
  dimension   SupplierQualityDimension
  rawValue    Float?
  numerator   Int?
  denominator Int?
  sampleSize  Int
  unit        String
  status      SupplierMetricStatus
  score       Float?
  sourceTrace Json
  createdAt   DateTime                  @default(now())

  @@unique([snapshotId, metricCode])
  @@index([metricCode, status])
}

model SupplierTierAssignment {
  id               String                   @id @default(uuid())
  vendorTenantId   String
  vendorTenant     Tenant                   @relation("SupplierTierAssignmentVendor", fields: [vendorTenantId], references: [id], onDelete: Restrict)
  tier             SupplierTier
  sourceSnapshotId String?
  sourceSnapshot   SupplierQualitySnapshot? @relation("SupplierTierAssignmentSourceSnapshot", fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  reason           String
  assignedById     String
  assignedBy       User                     @relation("SupplierTierAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt       DateTime
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  createdAt        DateTime                 @default(now())

  @@index([vendorTenantId, effectiveFrom])
  @@index([vendorTenantId, effectiveTo])
}

model SupplierQualityIssue {
  id               String                       @id @default(uuid())
  vendorTenantId   String
  vendorTenant     Tenant                       @relation("SupplierQualityIssueVendor", fields: [vendorTenantId], references: [id], onDelete: Restrict)
  snapshotId       String
  snapshot         SupplierQualitySnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  metricCode       SupplierQualityMetricCode
  dimension        SupplierQualityDimension
  severity         SupplierQualityIssueSeverity
  status           SupplierQualityIssueStatus   @default(OPEN)
  title            String
  details          Json
  openedAt         DateTime                     @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?                        @relation("SupplierQualityIssueAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?                        @relation("SupplierQualityIssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionReason String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([vendorTenantId, status, createdAt])
  @@index([metricCode, status])
}

model MarketplaceSearchObservation {
  id                            String       @id @default(uuid())
  agentTenantId                 String
  agentTenant                   Tenant       @relation("DemandSearchObservationAgent", fields: [agentTenantId], references: [id], onDelete: Restrict)
  searchAttemptId               String?
  observedAt                    DateTime     @default(now())
  serviceDate                   DateTime     @db.Date
  destinationNormalized         String?
  category                      String?
  subType                       String?
  durationMin                   Int?
  durationMax                   Int?
  priceMin                      Float?
  priceMax                      Float?
  currency                      String?
  bookingMode                   BookingMode?
  pickupIncluded                Boolean?
  minimumRating                 Float?
  privateShared                 String?
  childSuitable                 Boolean?
  units                         Int?
  totalPax                      Int
  travellerSummary              Json
  queryPresent                  Boolean
  queryHash                     String?
  candidateRatePlanCount        Int
  candidateSessionCount         Int
  eligibleOfferCountBeforePrice Int
  resultProductCount            Int
  resultOfferCount              Int
  zeroResult                    Boolean
  eligibilityFailureCounts      Json
  soldOutSessionIds             Json
  priceDiagnostics              Json
  createdAt                     DateTime     @default(now())

  @@unique([agentTenantId, searchAttemptId])
  @@index([observedAt])
  @@index([serviceDate])
  @@index([destinationNormalized])
  @@index([category])
  @@index([subType])
  @@index([agentTenantId])
}

model DemandIntelligencePolicy {
  id                    String                         @id @default(uuid())
  versionNumber         Int                            @unique
  status                DemandIntelligencePolicyStatus @default(DRAFT)
  name                  String
  measurementWindowDays Int
  futureHorizonDays     Int
  cooldownDays          Int
  lockVersion           Int                            @default(1)
  createdById           String
  createdBy             User                           @relation("DemandPolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activatedById         String?
  activatedBy           User?                          @relation("DemandPolicyActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  createdAt             DateTime                       @default(now())
  activatedAt           DateTime?
  retiredAt             DateTime?
  rules                 DemandOpportunityRule[]
  analysisRuns          DemandAnalysisRun[]
  assessments           DemandOpportunityAssessment[]

  @@index([status])
}

model DemandOpportunityRule {
  id                       String                    @id @default(uuid())
  policyId                 String
  policy                   DemandIntelligencePolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  type                     DemandOpportunityType
  enabled                  Boolean                   @default(true)
  defaultPriority          DemandOpportunityPriority
  minSearchCount           Int?
  minUniqueAgentCount      Int?
  maxAverageResultProducts Float?
  minZeroResultRate        Float?
  minSoldOutSessionCount   Int?
  minSoldOutRate           Float?
  minConfirmedBookingCount Int?
  minCancellationRate      Float?
  minPriceCeilingMissCount Int?
  minPriceCeilingMissRate  Float?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([policyId, type])
  @@index([type, enabled])
}

model DemandAnalysisRun {
  id             String                        @id @default(uuid())
  policyId       String
  policy         DemandIntelligencePolicy      @relation(fields: [policyId], references: [id], onDelete: Restrict)
  windowStart    DateTime
  windowEnd      DateTime
  horizonStart   DateTime
  horizonEnd     DateTime
  generatedById  String
  generatedBy    User                          @relation("DemandRunGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  candidateCount Int
  summary        Json
  generatedAt    DateTime                      @default(now())
  assessments    DemandOpportunityAssessment[]

  @@index([policyId, generatedAt])
}

model DemandOpportunity {
  id                    String                           @id @default(uuid())
  opportunityKey        String
  type                  DemandOpportunityType
  source                DemandOpportunitySource
  status                DemandOpportunityStatus          @default(OPEN)
  priority              DemandOpportunityPriority
  title                 String
  destinationNormalized String?
  cityName              String?
  stateName             String?
  countryName           String?
  category              String?
  subType               String?
  serviceDateFrom       DateTime?                        @db.Date
  serviceDateTo         DateTime?                        @db.Date
  durationMin           Int?
  durationMax           Int?
  currency              String?
  firstDetectedAt       DateTime                         @default(now())
  lastDetectedAt        DateTime                         @default(now())
  ownerUserId           String?
  ownerUser             User?                            @relation("DemandOpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  version               Int                              @default(1)
  resolvedAt            DateTime?
  resolutionType        DemandOpportunityResolutionType?
  resolutionReason      String?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  assessments           DemandOpportunityAssessment[]
  targets               DemandOpportunityVendorTarget[]
  events                DemandOpportunityEvent[]

  @@index([opportunityKey, status])
  @@index([status, priority, lastDetectedAt])
  @@index([type, status])
  @@index([destinationNormalized, serviceDateFrom])
}

model DemandOpportunityAssessment {
  id                String                   @id @default(uuid())
  opportunityId     String
  opportunity       DemandOpportunity        @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  analysisRunId     String
  analysisRun       DemandAnalysisRun        @relation(fields: [analysisRunId], references: [id], onDelete: Restrict)
  policyId          String
  policy            DemandIntelligencePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  windowStart       DateTime
  windowEnd         DateTime
  metrics           Json
  sourceTrace       Json
  recommendedAction String?
  generatedAt       DateTime                 @default(now())

  @@index([opportunityId, generatedAt])
  @@index([analysisRunId])
}

model DemandOpportunityVendorTarget {
  id             String             @id @default(uuid())
  opportunityId  String
  opportunity    DemandOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  vendorTenantId String
  vendorTenant   Tenant             @relation("DemandTargetVendor", fields: [vendorTenantId], references: [id], onDelete: Restrict)
  status         DemandTargetStatus @default(TARGETED)
  targetedById   String
  targetedBy     User               @relation("DemandTargetedBy", fields: [targetedById], references: [id], onDelete: Restrict)
  targetedAt     DateTime           @default(now())
  version        Int                @default(1)
  viewedAt       DateTime?
  respondedById  String?
  respondedBy    User?              @relation("DemandRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt    DateTime?
  responseNote   String?
  removedAt      DateTime?
  removedById    String?
  removedBy      User?              @relation("DemandRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  removalReason  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([opportunityId, vendorTenantId])
  @@index([vendorTenantId, status])
}

model DemandOpportunityEvent {
  id            String            @id @default(uuid())
  opportunityId String
  opportunity   DemandOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  eventType     String
  actorUserId   String?
  actor         User?             @relation("DemandEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reason        String?
  note          String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([opportunityId, createdAt])
  @@index([eventType, createdAt])
}
