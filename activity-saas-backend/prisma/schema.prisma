  booking             Booking?             @relation("BookingHolds", fields: [bookingId], references: [id], onDelete: Restrict)
  expiresAt           DateTime
  releasedAt          DateTime?
  convertedAt         DateTime?
  convertedAllocation InventoryAllocation?
  reason              String?
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([inventoryStateId, status])
  @@index([inventoryStateId, referenceKey])
  @@index([status, expiresAt])
}

