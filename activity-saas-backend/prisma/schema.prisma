  @@index([ratePlanId, minDaysBefore])
}

model ScheduleTemplate {
  id                         String                        @id @default(uuid())
  variantId                  String
  variant                    ProductVariant                @relation(fields: [variantId], references: [id], onDelete: Restrict)
  scheduleCode               String
