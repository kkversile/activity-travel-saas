  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([ratePlanId, scheduleTemplateId])
  @@index([scheduleTemplateId, active])
}

model ScheduleException {
  id                 String                @id @default(uuid())
  scheduleTemplateId String
  scheduleTemplate   ScheduleTemplate      @relation(fields: [scheduleTemplateId], references: [id], onDelete: Restrict)
  serviceDate        DateTime              @db.Date
  slotTemplateId     String?
  slotTemplate       ScheduleSlotTemplate? @relation(fields: [slotTemplateId], references: [id], onDelete: Restrict)
  type               ScheduleExceptionType
  reason             String
  exceptionKey       String                @unique
  archivedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([scheduleTemplateId, serviceDate, slotTemplateId])
}

model ServiceSession {
  id                  String                      @id @default(uuid())
  scheduleTemplateId  String
  scheduleTemplate    ScheduleTemplate            @relation(fields: [scheduleTemplateId], references: [id], onDelete: Restrict)
  slotTemplateId      String?
  slotTemplate        ScheduleSlotTemplate?       @relation(fields: [slotTemplateId], references: [id], onDelete: Restrict)
  serviceDate         DateTime                    @db.Date
  sessionKey          String
  localStartTime      String?
  localEndTime        String?
