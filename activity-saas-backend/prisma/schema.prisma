  releasedAt       DateTime?
  reason           String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([inventoryStateId, status])
  @@index([inventoryStateId, referenceKey])
}

model Resource {
