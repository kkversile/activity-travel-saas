  agentUser                               User?                                    @relation("BookingAgentUser", fields: [agentUserId], references: [id], onDelete: Restrict)
  productId                               String
  product                                 Product                                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productRevisionId                       String?
  productRevision                         ProductRevision?                         @relation(fields: [productRevisionId], references: [id], onDelete: Restrict)
  variantId                               String?
  variant                                 ProductVariant?                          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  ratePlanId                              String?
  ratePlan                                RatePlan?                                @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  sessionId                               String?
  session                                 ServiceSession?                          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  distributionChannelId                   String?
  distributionChannel                     DistributionChannel?                     @relation(fields: [distributionChannelId], references: [id], onDelete: Restrict)
  bookingMode                             BookingMode?
  channel                                 String
  serviceDate                             DateTime                                 @db.Date
  serviceTimezone                         String?
  pax                                     Int
  paxBreakdown                            Json                                     @default("{}")
  units                                   Int?
  capacityConsumption                     Int?
  amount                                  Decimal                                  @db.Decimal(12, 2)
  currency                                String                                   @default("INR")
  status                                  BookingStatus                            @default(PENDING)
  confirmationDueAt                       DateTime?
  confirmedAt                             DateTime?
  rejectedAt                              DateTime?
  expiredAt                               DateTime?
  idempotencyKey                          String?
  requestFingerprint                      String?
  customerName                            String
  customerEmail                           String?
  version                                 Int                                      @default(1)
