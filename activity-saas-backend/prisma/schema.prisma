  archivedAt                 DateTime?
  sourcePayload              Json?
  slotTemplates              ScheduleSlotTemplate[]
  ratePlanMappings           RatePlanSchedule[]
  sessions                   ServiceSession[]
  exceptions                 ScheduleException[]
  resourceRequirements       ScheduleResourceRequirement[]
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  @@unique([variantId, scheduleCode])
  @@index([variantId, status])
  @@index([variantId, effectiveFrom, effectiveTo])
}

model ScheduleSlotTemplate {
  id                 String              @id @default(uuid())
  scheduleTemplateId String
