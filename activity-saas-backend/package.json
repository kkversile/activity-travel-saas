    "verify:phase8-1": "node -r ts-node/register/transpile-only scripts/verify-phase8-1-fulfilment-integrity.ts",
    "verify:phase8-2": "node -r ts-node/register/transpile-only scripts/verify-phase8-2-regression-integrity.ts",
    "backfill:phase9": "tsx scripts/backfill-phase9-settlement.ts",
