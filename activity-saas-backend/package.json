{
  "name": "@voya/api",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@nestjs/cli": {
      "glob": "14.0.2"
    }
  },
  "scripts": {
