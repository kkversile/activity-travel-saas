    "verify:release:matrix": "node scripts/verify-release-matrix.cjs",
    "verify:schema:alignment": "node scripts/verify-schema-alignment.cjs",
    "test:operations": "node --test scripts/bootstrap-fresh-database.test.cjs",
    "verify:bulk-import:staging": "node scripts/verify-bulk-import-staging.cjs",
    "verify:object-storage": "node scripts/verify-object-storage.cjs",
    "verify:readiness:mail": "node scripts/verify-readiness-mail.cjs",
    "verify:readiness:backup": "node scripts/rehearse-readiness-operations.cjs",
    "verify:readiness:load": "node scripts/verify-readiness-load.cjs",
