    "rehearse:multi-outlet": "node scripts/rehearse-multi-outlet.cjs",
    "rehearse:staging-snapshot": "node scripts/rehearse-staging-snapshot.cjs",
    "verify:staging-copy": "node scripts/verify-staging-copy.cjs",
