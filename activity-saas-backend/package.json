    "verify:phase11": "node -r ts-node/register/transpile-only scripts/verify-phase11-demand.ts",
    "verify:phase11-1": "node -r ts-node/register/transpile-only scripts/verify-phase11-1-demand-integrity.ts",
    "verify:phase11-2": "node -r ts-node/register/transpile-only scripts/verify-phase11-2-demand-runtime.ts",
    "audit:phase12": "tsx scripts/audit-phase12-existing-channel.ts",
